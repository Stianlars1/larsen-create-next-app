{
  "name": "@larsen-utvikling/create-next-app",
  "version": "0.1.0",
  "description": "Scaffold the newest Next.js with the Larsen Utvikling design system: vanilla CSS design tokens, agent docs (AGENTS.md), and an optional 12-step color palette generated from a single HEX.",
  "keywords": [
    "create-next-app",
    "nextjs",
    "scaffold",
    "template",
    "design-tokens",
    "vanilla-css",
    "color-palette"
  ],
  "license": "MIT",
  "author": "Stian Larsen <stian.larsen@mac.com> (https://www.larsenutvikling.no)",
  "type": "module",
  "bin": {
    "create-next-app": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "palette",
    "template"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "gen:theme": "node ../palette/generate-default.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "node scripts/smoke.mjs --full",
    "prepack": "node scripts/sync.mjs",
    "prepublishOnly": "node scripts/smoke.mjs --dev"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@radix-ui/colors": "^3.0.0",
    "bezier-easing": "^2.1.0",
    "colorjs.io": "^0.5.2"
  }
}
