{
  "name": "@larsen-utvikling/create-next-app",
  "version": "0.5.0",
  "description": "Request create-next-app, then add the Larsen Utvikling vanilla CSS design system, agent docs, and an optional palette generated from one HEX.",
  "keywords": [
    "create-next-app",
    "nextjs",
    "scaffold",
    "template",
    "design-tokens",
    "vanilla-css",
    "color-palette"
  ],
  "license": "MIT",
  "author": "Stian Larsen <stian.larsen@mac.com> (https://www.larsenutvikling.no)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stianlars1/larsen-create-next-app.git",
    "directory": "create-next-app"
  },
  "homepage": "https://github.com/Stianlars1/larsen-create-next-app#readme",
  "bugs": {
    "url": "https://github.com/Stianlars1/larsen-create-next-app/issues"
  },
  "type": "module",
  "bin": {
    "create-next-app": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "palette",
    "template"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync.mjs",
    "gen:theme": "node ../palette/generate-default.mjs",
    "pack:release": "node scripts/pack-release.mjs --verify",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "node scripts/full-smoke.mjs",
    "prepack": "node scripts/sync.mjs",
    "prepublishOnly": "node scripts/refuse-source-publish.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@radix-ui/colors": "^3.0.0",
    "bezier-easing": "^2.1.0",
    "colorjs.io": "^0.5.2"
  }
}
